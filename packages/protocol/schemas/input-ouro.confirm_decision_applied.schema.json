{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "executionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "requestId": {
      "type": "string",
      "minLength": 8,
      "maxLength": 200
    },
    "expectedVersion": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "decisionRequestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "evidence": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    }
  },
  "required": [
    "executionId",
    "requestId",
    "expectedVersion",
    "decisionRequestId",
    "evidence"
  ],
  "additionalProperties": false,
  "$id": "urn:ouro:protocol:0.1.2:input:ouro.confirm_decision_applied"
}
