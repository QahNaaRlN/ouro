{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "executionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "requestId": {
      "type": "string",
      "minLength": 8,
      "maxLength": 200
    },
    "expectedVersion": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "report": {
      "type": "object",
      "properties": {
        "slice": {
          "type": "object",
          "properties": {
            "productRevision": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "testRevision": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "fixtureRevision": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "environmentDigest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "productRevision",
            "testRevision",
            "fixtureRevision",
            "environmentDigest"
          ],
          "additionalProperties": false
        },
        "scopeCaseIds": {
          "minItems": 1,
          "maxItems": 50,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "artifactRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "rawReport": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160000
        },
        "startedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        "finishedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        "flowStepRunId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "quality": {
          "type": "object",
          "properties": {
            "mutation": {
              "minItems": 1,
              "maxItems": 50,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "caseId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "killed": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "survived": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "noCoverage": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "timedOut": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "total": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "caseId",
                  "killed",
                  "survived",
                  "noCoverage",
                  "timedOut",
                  "total"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "mutation"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "slice",
        "scopeCaseIds",
        "artifactRef",
        "rawReport",
        "startedAt",
        "finishedAt"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "executionId",
    "requestId",
    "expectedVersion",
    "report"
  ],
  "additionalProperties": false,
  "$id": "urn:ouro:protocol:0.3.0:input:ouro.report_verification_run"
}
