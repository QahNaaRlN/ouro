{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "nodeId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "visit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "state": {
      "type": "string",
      "enum": [
        "ready",
        "running",
        "waiting",
        "succeeded",
        "failed",
        "skipped",
        "cancelled"
      ]
    },
    "createdAt": {
      "type": "string",
      "minLength": 1
    },
    "startedAt": {
      "type": "string",
      "minLength": 1
    },
    "finishedAt": {
      "type": "string",
      "minLength": 1
    },
    "evidence": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    },
    "retryOfRunId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    }
  },
  "required": [
    "id",
    "nodeId",
    "visit",
    "state",
    "createdAt"
  ],
  "additionalProperties": {
    "$ref": "#/$defs/__schema0"
  },
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        }
      ]
    }
  },
  "$id": "urn:ouro:protocol:0.1.2:flow-step-run"
}
