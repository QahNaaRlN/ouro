{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "verificationRevisionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "fromSlice": {
      "type": "object",
      "properties": {
        "productRevision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "testRevision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "fixtureRevision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "environmentDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "productRevision",
        "testRevision",
        "fixtureRevision",
        "environmentDigest"
      ],
      "additionalProperties": false
    },
    "toSlice": {
      "type": "object",
      "properties": {
        "productRevision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "testRevision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "fixtureRevision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "environmentDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "productRevision",
        "testRevision",
        "fixtureRevision",
        "environmentDigest"
      ],
      "additionalProperties": false
    },
    "scopeCaseIds": {
      "minItems": 1,
      "maxItems": 50,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "evidence": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "actorId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    }
  },
  "required": [
    "id",
    "verificationRevisionId",
    "fromSlice",
    "toSlice",
    "scopeCaseIds",
    "reason",
    "evidence",
    "actorId",
    "at"
  ],
  "additionalProperties": false,
  "$id": "urn:ouro:protocol:0.3.0:verification-refactor-admission"
}
