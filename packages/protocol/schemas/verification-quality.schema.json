{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "mutation": {
      "minItems": 1,
      "maxItems": 50,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "caseId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "killed": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "survived": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "noCoverage": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "timedOut": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "total": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "caseId",
          "killed",
          "survived",
          "noCoverage",
          "timedOut",
          "total"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "mutation"
  ],
  "additionalProperties": false,
  "$id": "urn:ouro:protocol:0.3.0:verification-quality"
