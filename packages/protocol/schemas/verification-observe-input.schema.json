{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "requestId": {
      "type": "string",
      "minLength": 8,
      "maxLength": 200
    },
    "expectedVersion": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "verificationRevisionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "config": {
      "type": "object",
      "properties": {
        "files": {
          "minItems": 1,
          "maxItems": 32,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "role": {
                "type": "string",
                "enum": [
                  "product",
                  "test",
                  "fixture",
                  "config"
                ]
              }
            },
            "required": [
              "path",
              "role"
            ],
            "additionalProperties": false
          }
        },
        "playwrightConfigPath": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "requiredCapabilities": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        }
      },
      "required": [
        "files",
        "playwrightConfigPath"
      ],
      "additionalProperties": false
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    }
  },
  "required": [
    "requestId",
    "expectedVersion",
    "verificationRevisionId"
  ],
  "additionalProperties": false,
  "$id": "urn:ouro:protocol:0.3.0:verification-observe-input"
}
