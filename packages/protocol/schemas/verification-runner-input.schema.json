{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "requestId": {
      "type": "string",
      "minLength": 8,
      "maxLength": 200
    },
    "expectedVersion": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "executionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "scopeCaseIds": {
      "minItems": 1,
      "maxItems": 50,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    }
  },
  "required": [
    "requestId",
    "expectedVersion",
    "executionId",
    "scopeCaseIds"
  ],
  "additionalProperties": false,
  "$id": "urn:ouro:protocol:0.3.0:verification-runner-input"
}
