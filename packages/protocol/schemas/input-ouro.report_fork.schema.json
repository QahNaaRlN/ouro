{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "executionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "requestId": {
      "type": "string",
      "minLength": 8,
      "maxLength": 200
    },
    "expectedVersion": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "context": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "flowNodeId": {
      "description": "Optional explicit process-node ID from the assigned immutable revision. Omit for unbound legacy facts; do not infer a path or human approval.",
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "flowStepRunId": {
      "description": "Required for new reports in an enforced Flow execution. The server binds the exact step occurrence and derives flowNodeId; a supplied node ID must match. Historical Action phases keep their original occurrence.",
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "reason": {
      "type": "string",
      "minLength": 50,
      "maxLength": 20000
    },
    "options": {
      "minItems": 2,
      "maxItems": 10,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20000
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20000
          }
        },
        "required": [
          "id",
          "title",
          "description"
        ],
        "additionalProperties": false
      }
    },
    "recommendationOptionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    }
  },
  "required": [
    "executionId",
    "requestId",
    "expectedVersion",
    "title",
    "context",
    "reason",
    "options"
  ],
  "additionalProperties": false,
  "$id": "urn:ouro:protocol:0.1.2:input:ouro.report_fork"
}
