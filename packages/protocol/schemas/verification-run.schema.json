{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "projectId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "executionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "verificationSpecId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "verificationRevisionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "targetSpecId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "targetRevisionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "slice": {
      "type": "object",
      "properties": {
        "productRevision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "testRevision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "fixtureRevision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "environmentDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "productRevision",
        "testRevision",
        "fixtureRevision",
        "environmentDigest"
      ],
      "additionalProperties": false
    },
    "scopeCaseIds": {
      "minItems": 1,
      "maxItems": 50,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    },
    "startedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "finishedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "recordedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "results": {
      "minItems": 1,
      "maxItems": 50,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "caseId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "outcome": {
            "type": "string",
            "enum": [
              "passed",
              "failed",
              "error",
              "skipped",
              "not_run"
            ]
          },
          "actual": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8000
          }
        },
        "required": [
          "caseId",
          "outcome",
          "actual"
        ],
        "additionalProperties": false
      }
    },
    "outcome": {
      "type": "string",
      "enum": [
        "passed",
        "failed",
        "error",
        "partial"
      ]
    },
    "source": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "imported_report"
            },
            "adapter": {
              "type": "string",
              "const": "playwright-json/v1"
            },
            "artifactRef": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "rawReport": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160000
            },
            "submittedBy": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          },
          "required": [
            "kind",
            "adapter",
            "artifactRef",
            "sha256",
            "rawReport",
            "submittedBy"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "human_attested"
            },
            "adapter": {
              "type": "string",
              "const": "manual/v1"
            },
            "artifactRef": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            },
            "evidence": {
              "type": "string",
              "minLength": 1,
              "maxLength": 20000
            },
            "submittedBy": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          },
          "required": [
            "kind",
            "adapter",
            "artifactRef",
            "evidence",
            "submittedBy"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "local_runner"
            },
            "adapter": {
              "type": "string",
              "const": "playwright-json/v1"
            },
            "verificationMethod": {
              "type": "string",
              "const": "server-owned-playwright-process"
            },
            "artifactRef": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "rawReport": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160000
            },
            "submittedBy": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "runnerVersion": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "exitCode": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            },
            "inputStability": {
              "type": "string",
              "enum": [
                "unchanged",
                "changed"
              ]
            }
          },
          "required": [
            "kind",
            "adapter",
            "verificationMethod",
            "artifactRef",
            "sha256",
            "rawReport",
            "submittedBy",
            "runnerVersion",
            "exitCode",
            "inputStability"
          ],
          "additionalProperties": false
        }
      ]
    },
    "flowStepRunId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "quality": {
      "type": "object",
      "properties": {
        "mutation": {
          "minItems": 1,
          "maxItems": 50,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "caseId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "killed": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "survived": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "noCoverage": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "timedOut": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "total": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "caseId",
              "killed",
              "survived",
              "noCoverage",
              "timedOut",
              "total"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "mutation"
      ],
      "additionalProperties": false
    },
    "artifactManifest": {
      "type": "object",
      "properties": {
        "files": {
          "maxItems": 32,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "role": {
                "type": "string",
                "enum": [
                  "product",
                  "test",
                  "fixture",
                  "config"
                ]
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "size": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "path",
              "role",
              "sha256",
              "size"
            ],
            "additionalProperties": false
          }
        },
        "capabilities": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        },
        "digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "files",
        "capabilities",
        "digest"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "id",
    "projectId",
    "executionId",
    "verificationSpecId",
    "verificationRevisionId",
    "targetSpecId",
    "targetRevisionId",
    "slice",
    "scopeCaseIds",
    "startedAt",
    "finishedAt",
    "recordedAt",
    "results",
    "outcome",
    "source"
  ],
  "additionalProperties": false,
  "$id": "urn:ouro:protocol:0.3.0:verification-run"
}
