{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "verificationRevisionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "configId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "observation": {
      "type": "object",
      "properties": {
        "files": {
          "maxItems": 32,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "role": {
                "type": "string",
                "enum": [
                  "product",
                  "test",
                  "fixture",
                  "config"
                ]
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "size": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "path",
              "role",
              "sha256",
              "size"
            ],
            "additionalProperties": false
          }
        },
        "capabilities": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        },
        "digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "slice": {
          "type": "object",
          "properties": {
            "productRevision": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "testRevision": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "fixtureRevision": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "environmentDigest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "productRevision",
            "testRevision",
            "fixtureRevision",
            "environmentDigest"
          ],
          "additionalProperties": false
        },
        "status": {
          "type": "string",
          "enum": [
            "observed",
            "unavailable"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      },
      "required": [
        "files",
        "capabilities",
        "digest",
        "slice",
        "status"
      ],
      "additionalProperties": false
    },
    "at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    }
  },
  "required": [
    "id",
    "verificationRevisionId",
    "configId",
    "observation",
    "at"
  ],
  "additionalProperties": false,
  "$id": "urn:ouro:protocol:0.3.0:verification-observation"
}
