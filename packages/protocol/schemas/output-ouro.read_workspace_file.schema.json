{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "text": {
      "type": "string",
      "maxLength": 131072
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "size": {
      "type": "integer",
      "minimum": 0,
      "maximum": 131072
    },
    "modifiedAt": {
      "type": "string",
      "minLength": 1
    },
    "ok": {
      "type": "boolean"
    },
    "projectId": {
      "type": "string",
      "minLength": 1
    },
    "executionId": {
      "type": "string",
      "minLength": 1
    },
    "bindingId": {
      "type": "string",
      "minLength": 1
    },
    "error": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string"
        },
        "details": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        },
        "retryable": {
          "type": "boolean",
          "const": false
        },
        "refreshRequired": {
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message",
        "retryable",
        "refreshRequired"
      ],
      "additionalProperties": {
        "$ref": "#/$defs/__schema0"
      }
    }
  },
  "required": [
    "ok"
  ],
  "additionalProperties": {
    "$ref": "#/$defs/__schema0"
  },
  "oneOf": [
    {
      "properties": {
        "ok": {
          "const": true
        }
      },
      "required": [
        "path",
        "text",
        "sha256",
        "size",
        "modifiedAt",
        "ok",
        "projectId",
        "executionId",
        "bindingId"
      ]
    },
    {
      "properties": {
        "ok": {
          "const": false
        }
      },
      "required": [
        "ok",
        "error"
      ]
    }
  ],
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        }
      ]
    }
  },
  "$id": "urn:ouro:protocol:0.1.2:output:ouro.read_workspace_file"
}
