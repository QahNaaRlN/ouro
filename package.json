{
  "name": "ouro",
  "version": "0.1.0-beta.4",
  "private": true,
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "scripts": {
    "predev": "npm run protocol:build",
    "dev": "node scripts/local-next.mjs dev",
    "preweb:dev": "npm run protocol:build",
    "web:dev": "npm --prefix apps/web run dev",
    "preweb:build": "npm run protocol:build",
    "web:build": "npm --prefix apps/web run build",
    "web:preview": "npm --prefix apps/web run preview",
    "preweb:typecheck": "npm run protocol:build",
    "web:typecheck": "npm --prefix apps/web run typecheck",
    "web:test:e2e": "playwright test --config=apps/web/playwright.config.ts",
    "preservice:typecheck": "npm run protocol:build",
    "service:typecheck": "npm --prefix apps/service run typecheck",
    "preservice:build": "npm run protocol:build",
    "service:build": "npm --prefix apps/service run build",
    "service:test": "npm run service:build && npm run web:build && npm --prefix apps/service test --",
    "prebuild": "npm run protocol:build",
    "build": "next build --webpack",
    "start": "node scripts/local-next.mjs start",
    "pretypecheck": "npm run protocol:build",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run protocol:build",
    "test": "npm run test:unit --",
    "test:unit": "tsx --no-wasm-code-gc --test --test-concurrency=1 tests/*.test.ts tests/source-quality.test.mts tests/protocol-producer-contract.test.mjs tests/protocol-producer-validation.test.mjs tests/source-workspace-launch.test.mjs",
    "pretest:e2e": "npm run protocol:build",
    "test:e2e": "playwright test",
    "mcp": "node packages/mcp/bin/ouro-mcp.mjs",
    "agent:check": "node scripts/check-agent.mjs",
    "predb:check": "npm run protocol:build",
    "db:check": "tsx scripts/check-db.ts",
    "protocol:build": "npm --prefix packages/protocol run build",
    "protocol:check": "npm --prefix packages/protocol run check",
    "protocol:pack": "npm run protocol:pack:npm --",
    "protocol:pack:npm": "node scripts/pack-protocol.mjs",
    "protocol:test-package": "npm run protocol:test-package:npm --",
    "protocol:test-package:npm": "node --test tests/protocol-package.test.mjs",
    "agent:config": "tsx scripts/agent-config.ts",
    "launch": "npm run launch:npm --",
    "launch:npm": "node scripts/launch.mjs",
    "release:pack": "node scripts/pack-release.mjs",
    "consumer:qualify": "npm run consumer:qualify:npm --",
    "consumer:qualify:npm": "node scripts/qualify-consumer-source.mjs",
    "consumer:qualify-envelope": "npm run consumer:qualify-envelope:npm --",
    "consumer:qualify-envelope:npm": "node scripts/qualify-consumer-envelope.mjs",
    "check:conventions": "node scripts/check-conventions.mjs",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:quality": "node scripts/check-quality.mjs",
    "test:quality": "node --test tests/source-quality.test.mts",
    "migration:check": "node scripts/check-migration-baseline.mjs",
    "styles:check": "node scripts/check-ui-styles.mjs",
    "styles:final": "node scripts/check-ui-styles.mjs --final",
    "test:e2e:production": "playwright test --config=playwright.production.config.ts",
    "start:hosted": "node scripts/hosted-next.mjs",
    "test:external-pg": "npm run protocol:build && node scripts/qualify-postgres.mjs",
    "hosting:verify": "tsx scripts/verify-postgres.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@dagrejs/dagre": "^1.1.8",
    "@electric-sql/pglite": "^0.3.14",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@node-rs/argon2": "^2.2.2",
    "@ouro/protocol": "workspace:*",
    "@tanstack/react-query": "5.105.3",
    "@xyflow/react": "^12.10.0",
    "dotenv": "16.3.1",
    "dotenv-expand": "10.0.0",
    "i18next": "26.7.1",
    "lib0": "^0.2.119",
    "lucide-react": "^0.468.0",
    "next": "16.4.3",
    "nodemailer": "^10.3.1",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "17.1.12",
    "tailwind-merge": "3.7.0",
    "yjs": "^13.6.33",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.56.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/dagre": "^0.7.53",
    "@types/node": "^24.10.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "ajv": "^8.20.0",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "eslint-plugin-jsdoc": "65.4.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "postcss": "8.5.32",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.72.1"
  }
}
