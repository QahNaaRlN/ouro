    "@electric-sql/pglite": "0.3.16",
    "pg": "8.23.1",
    "zod": "4.6.7",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@node-rs/argon2": "2.2.2",
    "nodemailer": "10.3.1",
    "yjs": "13.6.33",
    "lib0": "0.2.119",
    "@ouro/protocol": "file:../../packages/protocol",
    "@playwright/test": "1.64.1"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "esbuild": "0.28.2"
  }
