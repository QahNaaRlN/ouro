# Default: durable embedded PostgreSQL in .ouro/postgres (one Node process).
# To use external PostgreSQL, set DATABASE_URL and use a dedicated Ouro database.
# DATABASE_URL=postgresql://ouro:ouro@localhost:5432/ouro
# Agents are created in the Agents screen: per-agent keys need no server restart.
# Optional external public endpoint for MCP; HTTPS required outside loopback.
# OURO_PUBLIC_URL=https://ouro.example.com
# A human bearer is only for controlled API automation (browser SSO is not provided).
# OURO_HUMAN_TOKEN=replace-with-a-long-random-secret
# Legacy single-agent credential; prefer per-agent registration in the UI.
# OURO_AGENT_TOKEN=replace-with-a-different-long-random-secret
