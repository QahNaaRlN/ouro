# Copy to a protected file outside the source checkout; chmod 600.
# Keep the existing /opt/ouro/.env.hosting and old images unchanged.
OURO_IMAGE=ouro-app:replace-with-qualified-source-sha
OURO_EDGE_NETWORK=grace-production_edge
# Independent generated hex value: never reuse Grace secrets.
POSTGRES_ADMIN_PASSWORD=replace-with-independent-admin-random-hex
POSTGRES_PASSWORD=replace-with-different-app-random-hex
# Leave empty until real SMTP delivery is configured and qualified.
OURO_SMTP_URL=
OURO_SMTP_HOST=
OURO_SMTP_PORT=
OURO_SMTP_SECURE=
OURO_SMTP_USER=
OURO_SMTP_PASSWORD=
OURO_MAIL_FROM=
