{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "paths": {
      "@/*": ["./*"],
      "next/link": ["./apps/web/src/app/LegacyNavigationLink.tsx"],
      "next/navigation": ["./apps/web/src/app/useRouter.ts"]
    }
  },
  "include": ["apps/web/src", "apps/service/src", "app/**/*.tsx", "components", "lib", "packages/**/src", "scripts/**/*.d.mts"],
  "exclude": ["node_modules", "**/dist"]
}
