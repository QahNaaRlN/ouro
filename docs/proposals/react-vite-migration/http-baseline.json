{
  "contract": "ouro-http-baseline/v1",
  "source": {
    "commit": "3f8c986a8a5ddf272afc2ec8c08bc042b369d683",
    "next": "16.4.3",
    "fingerprint": "SHA-256 over UTF-8 source with LF line endings"
  },
  "scope": "Static route and method inventory; auth/headers/body/stream semantics require the referenced contract tests.",
  "constraints": [
    {
      "id": "METHODS",
      "requirement": "Preserve auto HEAD through GET, automatic OPTIONS 204 with sorted Allow, implicit 405 without Allow, and explicit MCP GET/DELETE 405 Allow: POST.",
      "tests": [
        "tests/protocol-mcp.test.ts",
        "tests/workspace-mcp.test.ts"
      ]
    },
    {
      "id": "COOKIES",
      "requirement": "Preserve three separate Set-Cookie values for account login/logout/invitation/reset successes and two for participant logout; never collapse headers into a plain object.",
      "tests": [
        "tests/user-auth-http.test.ts",
        "tests/participant-http.test.ts",
        "tests/auth-proxy-regressions.test.ts"
      ]
    },
    {
      "id": "BODIES",
      "requirement": "Generic JSON limit is 256000 bytes; webhook and Meridian import allow up to 2 MiB; verify GitHub HMAC over original bytes before parsing.",
      "tests": [
        "tests/github-http.test.ts",
        "tests/meridian-http.test.ts"
      ]
    },
    {
      "id": "STREAM",
      "requirement": "Project streams preserve snapshot/id/cursor/heartbeat, no-store/no-transform and X-Accel-Buffering:no, authorization and disconnect cleanup.",
      "tests": [
        "tests/project-stream.test.ts",
        "tests/participant-stream.test.ts"
      ]
    },
    {
      "id": "MCP",
      "requirement": "Current MCP HTTP is per-request finite JSON with closure, not an assumed event stream.",
      "tests": [
        "tests/mcp-server.test.ts",
        "tests/protocol-mcp.test.ts"
      ]
    },
    {
      "id": "JOBS",
      "requirement": "Replace only two Next after hooks with owned durable-job scheduling; preserve recovery worker and SQL leases.",
      "tests": [
        "tests/github-worker.test.ts",
        "tests/github-http.test.ts"
      ]
    },
    {
      "id": "RUNNER",
      "requirement": "Preserve 60-second default / 120-second bounded runner and current authorization/cancellation polling; HTTP timeouts must not truncate permitted work.",
      "tests": [
        "tests/verification-http.test.ts",
        "tests/verification-runtime.test.ts"
      ]
    },
    {
      "id": "UNKNOWN",
      "requirement": "Lost or invalid response after possible commit retains original actor/project/request ID/body and UNKNOWN until authoritative recovery; no blind mutation retry.",
      "tests": [
        "tests/collaborative-drafts.test.ts",
        "tests/verification-legacy-receipt.test.ts",
        "tests/access-recovery-regressions.test.ts"
      ]
    },
    {
      "id": "HEADER_LIMITS",
      "requirement": "Preserve existing endpoint-specific cache headers, including inbox success and events manual 422/409 exceptions, until an explicit behavior change is approved.",
      "tests": [
        "tests/workspace-http.test.ts",
        "tests/auth-proxy-regressions.test.ts"
      ]
    }
  ],
